# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://amishaaaaaa045_db_user:JGxCfdKovgDsPCgc@cluster0.5mzey5h.mongodb.net/rewear_nepal

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
# Access token lifetime is intentionally short (see JWT_EXPIRES_IN below,
# in the refresh-token section) — it's meant to be refreshed frequently via
# the rotating refresh token rather than living for weeks on its own.
JWT_COOKIE_EXPIRES_DAYS=1

// CSRF (double-submit cookie)
CSRF_SECRET=570841feeb002a7ad243b6617d31ab6eeb1b4ade1adf797dfef682dce6c0bd25cf73d25ffab07b61e862b284000e465a


# CORS
CLIENT_URL=http://localhost:5173

# Khalti Payment Gateway (https://docs.khalti.com/khalti-epayment/)
# Use your test secret key while developing, and your live key in production.
# NEVER commit real keys or expose the secret key to the frontend.
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_BASE_URL=https://a.khalti.com/api/v2/epayment
# Where Khalti redirects the user after completing/cancelling payment
KHALTI_RETURN_URL=http://localhost:3000/payment/callback
# Your frontend's base URL, required by Khalti's initiate API
KHALTI_WEBSITE_URL=http://localhost:3000

# Email (Nodemailer)
# Option A — named service (simplest for Gmail/Outlook/Yahoo etc.):
#   EMAIL_SERVICE=gmail
#   For Gmail, EMAIL_PASSWORD must be an "App Password", not your normal
#   account password: https://myaccount.google.com/apppasswords
# Option B — generic SMTP host (e.g. Mailtrap, SendGrid SMTP, Amazon SES):
#   leave EMAIL_SERVICE blank and set EMAIL_HOST/EMAIL_PORT instead.
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
# Shown as the email's display name and used as the fallback "from" address
EMAIL_FROM_NAME=Our Store
EMAIL_FROM_ADDRESS=your_email@example.com

# Image Storage — "local" (disk, served via /uploads) or "cloudinary"
STORAGE_PROVIDER=local

# Only required when STORAGE_PROVIDER=cloudinary
# https://cloudinary.com/documentation/node_integration#configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# Password hashing cost factor (bcrypt). Higher = slower to compute =
# more resistant to offline brute-forcing, at the cost of CPU time per
# login/registration. 12 is a reasonable default in 2026; increase over
# time as hardware gets faster.
BCRYPT_SALT_ROUNDS=12

# Password policy: how many previous passwords to block re-use of, and
# how many days before a password must be changed (0 disables expiry).
PASSWORD_HISTORY_LIMIT=5
PASSWORD_EXPIRY_DAYS=90

MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

ENCRYPTION_KEY=change_this_to_a_long_random_32_byte_secret

# Session/cookie behavior
COOKIE_SAME_SITE=lax

BIND_SESSION_TO_USER_AGENT=true

BLOCKED_IPS=
ALLOWED_IPS=
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_SENSITIVE_MAX=30

TRUST_PROXY=false

# reCAPTCHA (Google test keys below always pass and work on localhost — replace
# with your own keys from google.com/recaptcha/admin before real deployment)
RECAPTCHA_SECRET_KEY=6Ldc52wtAAAAAAuh6Fh4nNGmEsPcl9n9Z-EcjiO0

# Dual JWT secrets: admin-role tokens are signed/verified with a separate
# secret from regular users, so a leak of one secret alone cannot forge
# tokens for the other role.
JWT_ADMIN_SECRET=28be57408e8728085429036cfbba3feffe0403516ddeddd800101957efe948f1e545c7308820833b0a7b480cb190a60d

# Access token lifetime — short by design; /api/auth/refresh silently
# mints a new one using the (much longer-lived, rotating, revocable)
# refresh token below, so this doesn't force frequent re-logins.
JWT_EXPIRES_IN=15m

# Refresh token rotation
REFRESH_TOKEN_EXPIRES_DAYS=30

# Security-event/audit logging threshold
MAX_LOGIN_ATTEMPTS=5

# Real-time security alerting (src/utils/securityAlertService.js).
# Fires on: account lockouts, repeated attempts against a locked account,
# refresh-token reuse detection, repeated MFA failures, and destructive
# admin actions (role change/delete). Either or both channels can be set;
# if neither is set, alerting is a silent no-op.
#   SECURITY_ALERT_EMAIL          - inbox that receives the alert email
#   SECURITY_ALERT_WEBHOOK_URL    - Slack incoming-webhook URL (or any
#                                   endpoint that accepts { "text": "..." })
#   SECURITY_ALERT_THROTTLE_MINUTES - min gap between repeat alerts for the
#                                   same event+user, default 15
SECURITY_ALERT_EMAIL=
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_THROTTLE_MINUTES=15
